{
  "name": "delivery-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm cf-typegen && portless run vite",
    "build": "pnpm typecheck && cf build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "pnpm build && cf deploy --prebuilt --mode production --dry-run",
    "lint": "pnpm cf-typegen && oxlint . --deny-warnings --report-unused-disable-directives && pnpm check:file-names",
    "lint:fix": "pnpm cf-typegen && oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "check:file-names": "node scripts/check-file-names.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck",
    "test": "vitest run",
    "cf-typegen": "cf workers types",
    "typecheck": "pnpm cf-typegen && tsc -b",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-c82c3efb3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.17",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12.2.1 <13"
  },
  "packageManager": "pnpm@12.11.2"
}
