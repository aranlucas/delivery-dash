{
  "name": "delivery-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm cf-typegen && portless run vite",
    "build": "pnpm typecheck && cf build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "pnpm build && cf deploy --prebuilt --mode production --dry-run",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives && pnpm check:file-names",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "check:file-names": "node scripts/check-file-names.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck",
    "test": "node --test 'src/**/*.test.ts'",
    "cf-typegen": "cf workers types",
    "typecheck": "pnpm cf-typegen && tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.13",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "portless": "0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12.2.1 <13"
  },
  "packageManager": "pnpm@12.10.1"
}
