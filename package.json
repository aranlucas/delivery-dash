{
  "name": "delivery-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck",
    "test": "node --test 'src/**/*.test.ts'",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm cf-typegen && tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12.2.1 <13"
  },
  "packageManager": "pnpm@12.3.1"
}
