{
  "name": "delivery-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run vite",
    "build": "cf build && pnpm typecheck",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "pnpm build && cf deploy --prebuilt --mode production --dry-run",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives && pnpm check:file-names",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "check:file-names": "node scripts/check-file-names.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm build",
    "test": "vitest run",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-805ec1ff3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.17",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings --report-unused-disable-directives",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12.2.1 <13"
  },
  "packageManager": "pnpm@12.11.2"
}
