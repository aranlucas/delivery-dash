{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "cloudflare.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "e2e.config.ts",
    "test/e2e/**/*.ts",
    "src/shared/wire-schema.ts"
  ]
}
